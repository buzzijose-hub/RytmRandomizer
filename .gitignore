# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Local exports / archives
Exports/
Backups/
LegacyScripts/
*.zip

# Local capture / generated files
*.log
*.tmp

# Coverage artifacts (generated by scripts/coverage_check.py / pytest-cov)
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
Docs/Session_Logs/*.log
Docs/Session_Logs/latest_closeout_summary.txt

# Agent process artifacts
# Ignore the .claude/ directory by default (local agent state, transcripts,
# caches, etc.), but explicitly track the committed rules / skills / agents /
# settings that codify the architecture (WS-T):
#   - .claude/rules/         agent-facing distillation of docs/ARCHITECTURE.md
#   - .claude/skills/        repo-specific skills (code-review, etc.)
#   - .claude/agents/        repo-specific agent definitions
#   - .claude/settings.json  post-push code-review hook config
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/agents/
!.claude/settings.json
docs-scratch/
