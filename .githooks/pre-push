#!/usr/bin/env bash
# RytmRandomizer pre-push hook — the universal, tool-agnostic review backstop.
#
# This hook fires on EVERY `git push`, no matter what drives it: Claude Code,
# codex, a human at a terminal, an IDE button. It runs the mechanical
# code-review gates (lint + strict production typing + architecture + V1.34 parity) via the shared
# scripts/code_review_gate.py and ABORTS the push (non-zero exit) if any gate
# fails. Zero copy-paste, zero per-tool wiring.
#
# It is versioned in the repo under .githooks/ and activated by pointing
# git at it:  git config core.hooksPath .githooks
# `just install` and the dev container's postCreateCommand do this for you,
# so a fresh clone is one `just install` away from having the hook live.
#
# This hook covers only the MECHANICAL half of the 8-step review. The two
# judgement steps — Step 7 (abstraction reuse) and Step 8 (architecture-doc
# + diagram freshness) — are completed by the agent's post-push hook
# (.claude/settings.json for Claude Code; .codex/hooks.json for codex) or by
# a manual `just review`. See docs/CODE_REVIEW_HOOK_SETUP.md.
#
# Emergency bypass (discouraged — CI's `architecture` job still rejects the
# violation server-side):  git push --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Find a python that actually executes. On Windows, the bare names
# (`python`, `python3`, `py`) often resolve to Microsoft Store stub
# executables under %LOCALAPPDATA%\Microsoft\WindowsApps\ that throw
# "Permission denied" / "The system cannot find the path specified" when
# invoked from a subprocess (git hooks run non-interactively). The fix:
# probe each candidate with `--version` and skip the ones that fail.
_pyworks() {
    # Returns 0 if the given python prints a version line cleanly,
    # 1 otherwise (Store shim, missing binary, broken venv, etc.).
    "$1" --version >/dev/null 2>&1
}

# Candidate list in priority order: PATH lookups first (handles venv-
# activated shells, conda envs, normal Unix installs), then well-known
# Windows install paths as last-resort fallbacks.
PY=""
for candidate in python3 python py "/c/Program Files/WindowsApps/PythonSoftwareFoundation.Python.3.13_3.13.3568.0_x64__qbz5n2kfra8p0/python3.13.exe" "/c/Program Files/WindowsApps/PythonSoftwareFoundation.Python.3.12_3.12.3568.0_x64__qbz5n2kfra8p0/python3.12.exe" "/c/Program Files/WindowsApps/PythonSoftwareFoundation.Python.3.11_3.11.2544.0_x64__qbz5n2kfra8p0/python3.11.exe"; do
    if command -v "$candidate" >/dev/null 2>&1 || [[ -x "$candidate" ]]; then
        if _pyworks "$candidate"; then
            PY="$candidate"
            break
        fi
    fi
done

if [[ -z "$PY" ]]; then
    echo "[pre-push] no working python found (all candidates fail --version)." >&2
    echo "[pre-push] skipping local gate; CI's architecture job will enforce it." >&2
    exit 0
fi

exec "$PY" "$REPO_ROOT/scripts/code_review_gate.py" --mode git-hook
