# =============================================================================
# coverage.py configuration for RytmRandomizer
# =============================================================================
#
# RATCHETING, PACKAGE-FIRST COVERAGE POLICY
# -----------------------------------------
# Coverage is enforced "package-first": the modular `rytm_randomizer/` package
# is held to 100% BRANCH coverage right now. The legacy V1.34 monolith that
# Wave 4 decomposed has been retired (2026-05-17); its reference behavior is
# captured as JSON goldens under `tests/fixtures/v134_parity/`. Coverage now
# only measures the package, which is the single source of runtime truth.
#
# The whole-repo coverage floor only ever goes UP (it ratchets): once a wave
# raises the measured number, that becomes the new minimum. It never regresses.
#
# This file is a STANDALONE `.coveragerc` (coverage.py reads it natively) so
# the configuration works independently of `pyproject.toml`. A parallel
# workstream (WS-A) owns `pyproject.toml` and only has stub coverage sections
# there; keeping config here avoids a merge collision.
# =============================================================================

[run]
branch = True
source = rytm_randomizer

[report]
# Ratcheting baseline: bumped to the measured PURE-BRANCH number each
# time a coverage-improving PR lands. Never lower it. Target is 100%
# after the coverage-to-100 workstream covers cli.py / shell.py /
# mido_provider.py.
#
# Note: coverage.py's own fail_under gate compares against its BLENDED
# (line+branch) metric, which is always >= the pure-branch number. We
# pin against pure-branch here so the gate matches what scripts/
# coverage_ratchet.py reports from coverage.xml's branch-rate
# attribute. The two stay in lockstep: bump only when pure-branch
# rises by >=1pp.
fail_under = 97
show_missing = True
# NOTE: exclude_lines entries are regular expressions, so literal characters
# like "(" are escaped below.
exclude_lines =
    # Standard opt-out marker (paired with a one-line WHY comment at site).
    pragma: no cover

    # ----- Unreachable-by-construction patterns --------------------------
    # `if TYPE_CHECKING:` blocks exist only to silence circular-import
    # warnings for type checkers; runtime never enters them.
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:

    # Script entry points. The package is library-first; the `__main__`
    # guard lets a module be runnable for one-off debugging but is not
    # the official entry point (that is the `rytm-randomizer` console
    # script wired in [project.scripts]).
    if __name__ == .__main__.:

    # Defensive guards that mirror language constraints. The type system
    # or a frozen dataclass already prevents the value from reaching this
    # branch; the runtime check is there so a future refactor that loosens
    # the type does not silently produce wrong behavior.
    raise NotImplementedError

    # Protocol method stubs declared with `...` (Ellipsis-only bodies).
    ^\s*\.\.\.\s*$

    # Abstract-method decorators -- by definition the abstract method is
    # never called directly; the concrete override is.
    @(abc\.)?abstractmethod

    # ----- Hardware I/O boundary -----------------------------------------
    # The lines below touch real MIDI hardware (the Elektron Analog Rytm MK2)
    # or interactive stdin. They CANNOT be exercised honestly in CI without
    # physical hardware attached, so covering them would require dishonest
    # mock-stuffing. They are the hardware boundary and are excluded by
    # design -- logic around them is tested via fakes/adapters in the package.
    mido\.open_output
    out\.send
    input\(
    get_output_names
