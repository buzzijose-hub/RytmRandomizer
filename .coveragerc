# =============================================================================
# coverage.py configuration for RytmRandomizer
# =============================================================================
#
# RATCHETING, PACKAGE-FIRST COVERAGE POLICY
# -----------------------------------------
# Coverage is enforced "package-first": the modular `rytm_randomizer/` package
# is held to 100% BRANCH coverage right now. The legacy monolith
# (`rytm_hybrid_randomizer_v134.py`) is intentionally NOT in `source` below --
# it reaches 100% organically as Wave 4 EXTRACTS its logic into the package,
# not by mock-stuffing tests around the monolith.
#
# The whole-repo coverage floor only ever goes UP (it ratchets): once a wave
# raises the measured number, that becomes the new minimum. It never regresses.
#
# This file is a STANDALONE `.coveragerc` (coverage.py reads it natively) so
# the configuration works independently of `pyproject.toml`. A parallel
# workstream (WS-A) owns `pyproject.toml` and only has stub coverage sections
# there; keeping config here avoids a merge collision.
# =============================================================================

[run]
branch = True
source = rytm_randomizer

[report]
show_missing = True
# NOTE: exclude_lines entries are regular expressions, so literal characters
# like "(" are escaped below.
exclude_lines =
    # Standard opt-out marker
    pragma: no cover

    # ----- Hardware I/O boundary -----------------------------------------
    # The lines below touch real MIDI hardware (the Elektron Analog Rytm MK2)
    # or interactive stdin. They CANNOT be exercised honestly in CI without
    # physical hardware attached, so covering them would require dishonest
    # mock-stuffing. They are the hardware boundary and are excluded by
    # design -- logic around them is tested via fakes/adapters in the package.
    mido\.open_output
    out\.send
    input\(
    get_output_names
