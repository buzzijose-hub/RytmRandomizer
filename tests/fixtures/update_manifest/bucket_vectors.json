{
  "schema_version": 1,
  "rule": {
    "description": "Deterministic staged-rollout bucketing (spec section 5). Hash the UTF-8 bytes of the anonymous install id with SHA-256, read the FIRST FOUR bytes of the digest as a big-endian unsigned 32-bit integer, and take that value modulo 100. The install takes the update iff bucket < rollout_percent, so rollout_percent 0 admits nobody and 100 admits everybody.",
    "hash": "sha256",
    "input_encoding": "utf-8",
    "digest_prefix_bytes": 4,
    "prefix_endianness": "big",
    "modulus": 100,
    "eligibility": "bucket < rollout_percent"
  },
